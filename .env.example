# Civitatis
CIVITATIS_BASE_URL=https://www.civitatis.com
CIVITATIS_PROVIDER_URL=https://www.civitatis.com/en/providers/
CIVITATIS_BOOKINGS_URL=https://www.civitatis.com/en/providers/v2/bookings/
=
CIVITATIS_USERNAME=@gmail.com
CIVITATIS_PASSWORD=xxxxxxx
=
# Persistent browser profile.
BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
BROWSER_USER_DATA_DIR=./data/browser-profile
BROWSER_HEADLESS=true
=
# Login selectors - adjust if Civitatis changes its HTML.
CIVITATIS_USERNAME_SELECTOR=input[name="email"]
CIVITATIS_PASSWORD_SELECTOR=input[type="password"]
CIVITATIS_LOGIN_BUTTON_SELECTOR=button[type="submit"]
=
# OTP selectors - adjust to the actual Civitatis OTP page.
CIVITATIS_OTP_INPUT_SELECTOR=input[name="otp"]
CIVITATIS_OTP_SUBMIT_SELECTOR=button[type="submit"]
=
# Session detection.
CIVITATIS_AUTH_SELECTOR=
CIVITATIS_LOGIN_PAGE_MATCH=/login|signin|auth/i
=
# OTP email rules.
OTP_EMAIL_FROM=
OTP_EMAIL_SUBJECT_REGEX=code|verification|otp
OTP_CODE_REGEX=\b(\d{4,8})\b
OTP_LOOKBACK_SECONDS=300
OTP_POLL_INTERVAL_MS=3000
OTP_TIMEOUT_MS=120000
=
# Gmail API
GOOGLE_CLIENT_ID=.apps.googleusercontent.com
